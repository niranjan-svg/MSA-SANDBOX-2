<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <aggregates>
        <calculatedFormula>IF(
  OR(
    GiftTransaction.GiftType = &quot;Individual&quot;,
    GiftTransaction.GiftType = &quot;Organization/Household&quot;
  ),
  GiftTransaction.OriginalAmount:SUM,
  0
)</calculatedFormula>
        <datatype>number</datatype>
        <developerName>FORMULA1</developerName>
        <isActive>false</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>Total Donation</masterLabel>
        <scale>2</scale>
    </aggregates>
    <columns>
        <field>Account$Name</field>
    </columns>
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>Account.GiftCommitment.GiftTransaction$OriginalAmount</field>
    </columns>
    <format>Matrix</format>
    <groupingsAcross>
        <dateGranularity>Day</dateGranularity>
        <field>Account.GiftCommitment.GiftTransaction$CurrentAmount</field>
        <sortOrder>Asc</sortOrder>
    </groupingsAcross>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>Account.GiftCommitment.GiftTransaction$GiftType</field>
        <sortOrder>Desc</sortOrder>
    </groupingsDown>
    <name>Total Donations - ACM-1.6.1</name>
    <params>
        <name>co</name>
        <value>1</value>
    </params>
    <reportType>Gift_commitments_and_Account__c</reportType>
    <scope>user</scope>
    <showDetails>true</showDetails>
    <showGrandTotal>true</showGrandTotal>
    <showSubTotals>true</showSubTotals>
    <timeFrameFilter>
        <dateColumn>Account$CreatedDate</dateColumn>
        <interval>INTERVAL_CUSTOM</interval>
    </timeFrameFilter>
</Report>
