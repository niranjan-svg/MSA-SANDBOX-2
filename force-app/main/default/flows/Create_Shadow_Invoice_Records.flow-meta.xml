    <decisions>
        <name>Check_If_the_Account_Is_LP</name>
        <label>Check If the Account Is LP</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Account_Is_LP</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Billed_For_Account__r.Program_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Local Program</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Billed_For_Account__r.Program_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Sub Member</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Shadow_Invoice</targetReference>
            </connector>
            <label>Account Is LP</label>
        </rules>
    </decisions>
