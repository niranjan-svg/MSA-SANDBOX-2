<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_to_Totals</name>
        <label>Add to Totals</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>var_TotalAmount</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Through_Awards.Total_Disbursed_Amount__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_AwardCount</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Through_Awards</targetReference>
        </connector>
    </assignments>
    <description>Roll-Up Funding Awards to Opportunity</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_FundingOpportunityId</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE({!$Record.FundingOpportunityId}, {!$Record__Prior.FundingOpportunityId})</expression>
    </formulas>
    <interviewLabel>Funding Opportunity Total Disbursed Amount {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Funding Opportunity Total Disbursed Amount</label>
    <loops>
        <name>Loop_Through_Awards</name>
        <label>Loop Through Awards</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_All_Related_Awards</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_to_Totals</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Parent_Opportunity</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_All_Related_Awards</name>
        <label>Get All Related Awards</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Through_Awards</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>FundingOpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>formula_FundingOpportunityId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>FundingAward</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Parent_Opportunity</name>
        <label>Update Parent Opportunity</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ParentFundingOpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>var_FundingOpportunityId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Number_of_Awards__c</field>
            <value>
                <elementReference>var_AwardCount</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Total_Award_Amount__c</field>
            <value>
                <elementReference>var_TotalAmount</elementReference>
            </value>
        </inputAssignments>
        <object>FundingOpportunity</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_All_Related_Awards</targetReference>
        </connector>
        <object>FundingAward</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>var_AwardCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <scale>0</scale>
    </variables>
    <variables>
        <name>var_FundingOpportunityId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>var_TotalAmount</name>
        <dataType>Currency</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <scale>2</scale>
    </variables>
</Flow>
