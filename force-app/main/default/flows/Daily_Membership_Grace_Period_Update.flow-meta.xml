<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <environments>Default</environments>
    <formulas>
        <name>yesterdayDate</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} - 1</expression>
    </formulas>
    <interviewLabel>Daily - Membership Grace Period Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Daily - Membership Grace Period Update</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Statuses_to_Grace_Period</name>
        <label>Update Statuses to Grace Period</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>TermEndDate__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>yesterdayDate</elementReference>
            </value>
        </filters>
        <filters>
            <field>Membership_Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>In Grace Period</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Membership_Status__c</field>
            <value>
                <stringValue>In Grace Period</stringValue>
            </value>
        </inputAssignments>
        <object>Memberships__c</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Statuses_to_Grace_Period</targetReference>
        </connector>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2025-08-13</startDate>
            <startTime>05:31:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Obsolete</status>
