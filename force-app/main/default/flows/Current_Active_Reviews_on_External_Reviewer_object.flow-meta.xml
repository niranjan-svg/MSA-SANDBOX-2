<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Count_Active_Reviews</name>
        <label>Count Active Reviews</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varActiveReviewCount</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Get_All_Active_Reviews_for_Reviewer</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Current_Reviewer_Count</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Count_Remaining_Reviews</name>
        <label>Count_Remaining_Reviews</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varActiveReviewCount</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Get_Remaining_Reviews</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Reviewer_After_Delete</targetReference>
        </connector>
    </assignments>
    <description>This flow is to calculate the current active reviews on external reviewer object based on the application review object</description>
    <environments>Default</environments>
    <interviewLabel>Current Active Reviews on External Reviewer object {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Current Active Reviews on External Reviewer object</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_All_Active_Reviews_for_Reviewer</name>
        <label>Get All Active Reviews for Reviewer</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Count_Active_Reviews</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>External_Reviewer__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.External_Reviewer__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Canceled</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>ApplicationReview</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Current_Reviewer_ID</name>
        <label>Get Current Reviewer ID</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_All_Active_Reviews_for_Reviewer</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>ApplicationReview</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Remaining_Reviews</name>
        <label>Get_Remaining_Reviews</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Count_Remaining_Reviews</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>External_Reviewer__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record__Prior.External_Reviewer__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Canceled</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>ApplicationReview</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Current_Reviewer_Count</name>
        <label>Update Current Reviewer Count</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Remaining_Reviews</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.External_Reviewer__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Current_Active_Reviews__c</field>
            <value>
                <elementReference>varActiveReviewCount</elementReference>
            </value>
        </inputAssignments>
        <object>External_Reviewer__c</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Reviewer_After_Delete</name>
        <label>Update_Reviewer_After_Delete</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record__Prior.External_Reviewer__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Current_Active_Reviews__c</field>
            <value>
                <elementReference>varActiveReviewCount</elementReference>
            </value>
        </inputAssignments>
        <object>External_Reviewer__c</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Current_Reviewer_ID</targetReference>
        </connector>
        <object>ApplicationReview</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
    <variables>
        <name>varActiveReviewCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <scale>0</scale>
    </variables>
</Flow>
