    <decisions>
        <name>Check_Membership_Type_Price</name>
        <label>Check Membership Type Price</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Lesser_than_existing1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Membership_Type__r.Price__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>$Record__Prior.Membership_Type__r.Price__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Membership_Transaction_Record</targetReference>
            </connector>
            <label>Lesser than existing</label>
        </rules>
        <rules>
            <name>Greater_than_existing1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Membership_Type__r.Price__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>$Record__Prior.Membership_Type__r.Price__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Show_Upgrade_Message</targetReference>
            </connector>
            <label>Greater than existing</label>
        </rules>
    </decisions>
