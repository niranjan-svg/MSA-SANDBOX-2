    <environments>Default</environments>
    <formulas>
        <name>checkAccountIsCPorLP</name>
        <dataType>String</dataType>
        <expression>IF(
    TEXT({!Get_Account_Record.Program_Type__c}) = &quot;Coordinating Program&quot;,
    {!Get_Account_Record.Id},

    IF(
        AND(
            TEXT({!Get_Account_Record.Program_Type__c}) = &quot;Local Program&quot;,
            {!Get_Account_Record.IsPersonAccount} = TRUE,
            {!Get_Account_Record.Paid_By_CP__c} = TRUE,
            NOT(ISBLANK({!Get_Account_Record.Parent_Account__c}))
        ),
        {!Get_Account_Record.Parent_Account__c},

        IF(
            AND(
                TEXT({!Get_Account_Record.Program_Type__c}) = &quot;Local Program&quot;,
                {!Get_Account_Record.IsPersonAccount} = FALSE,
                {!Get_Account_Record.Paid_By_CP__c} = TRUE,
                NOT(ISBLANK({!Get_Account_Record.Coordinating_Program__c}))
            ),
            {!Get_Account_Record.Coordinating_Program__c},
            NULL
        )
    )
)</expression>
    </formulas>
    <formulas>
        <name>greaterThanExisting</name>
        <dataType>Currency</dataType>
        <expression>IF(
    {!$Record.Membership_Type__r.Price__c} &gt; {!$Record__Prior.Membership_Type__r.Price__c},
    {!$Record.Membership_Type__r.Price__c} - {!$Record__Prior.Membership_Type__r.Price__c},
    0
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>lesserThanExisting</name>
        <dataType>Currency</dataType>
        <expression>IF(
    {!$Record.Membership_Type__r.Price__c} &lt; {!$Record__Prior.Membership_Type__r.Price__c},
    {!$Record__Prior.Membership_Type__r.Price__c} - {!$Record.Membership_Type__r.Price__c},
    0
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>today</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <formulas>
        <name>todayPlus7</name>
        <dataType>Date</dataType>
        <expression>TODAY()+7</expression>
    </formulas>
