<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_Parent_Allocated_Subgrant_Amount</name>
        <label>Check Parent Allocated Subgrant Amount</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Check_if_already_has_value</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ParentFundingOpportunity.Total_Allocated_Subgrant_Amount__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_existing_value</targetReference>
            </connector>
            <label>Check if already has value</label>
        </rules>
        <rules>
            <name>Check_if_not_present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ParentFundingOpportunity.Total_Allocated_Subgrant_Amount__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_new_Value</targetReference>
            </connector>
            <label>Check if not present</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>totalAllocatedSubGrantIfExists</name>
        <dataType>Currency</dataType>
        <expression>{!$Record.ParentFundingOpportunity.Total_Allocated_Subgrant_Amount__c}+{!$Record.Total_Grant_Amount__c}</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Total vs Allocated Sub Grants Calculation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Total vs Allocated Sub Grants Calculation</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_existing_value</name>
        <label>Update existing value</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ParentFundingOpportunity.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Total_Allocated_Subgrant_Amount__c</field>
            <value>
                <elementReference>totalAllocatedSubGrantIfExists</elementReference>
            </value>
        </inputAssignments>
        <object>FundingOpportunity</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_new_Value</name>
        <label>Update new Value</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ParentFundingOpportunity.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Total_Allocated_Subgrant_Amount__c</field>
            <value>
                <elementReference>$Record.Total_Grant_Amount__c</elementReference>
            </value>
        </inputAssignments>
        <object>FundingOpportunity</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Parent_Allocated_Subgrant_Amount</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ParentFundingOpportunityId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>FundingOpportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
</Flow>
